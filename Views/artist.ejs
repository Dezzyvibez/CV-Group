<!-- artist-form.html -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Join the Roster | Chopvibe Music</title>
	<link rel="icon" href="img/CVLogo-32x32.png" type="image/x-icon"/>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;700;800&display=swap" rel="stylesheet">
    <style>
        :root { --red: #1c1c1c; --black: #0B0B0B; --white: #FFFFFF; --yellow: #D4B96D; }
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: var(--white); color: var(--black); padding: 20px; }
        .form-container { max-width: 500px; margin: 0 auto; padding: 40px; border-radius: 20px; box-shadow: 0 20px 50px rgba(0,0,0,0.1); }
        h1 { font-weight: 800; margin-bottom: 10px; font-size: 2rem; letter-spacing: -1px; }
        p { color: #666; margin-bottom: 30px; font-size: 0.9rem; }
        .input-group { margin-bottom: 20px; }
        label { display: block; font-weight: 700; font-size: 0.8rem; margin-bottom: 8px; text-transform: uppercase; }
        input, textarea { width: 100%; outline: none; padding: 15px; border: 2px solid #eee; box-sizing: border-box; border-radius: 10px; font-size: 1rem; transition: 0.3s; }
        textarea:focus{var(--yellow);}
		input:focus { border-color: var(--yellow); outline: none; }
        .btn-submit { cursor: pointer;width: 100%; background: var(--red); color: white; border: none; padding: 18px; border-radius: 10px; font-weight: 800; cursor: pointer; font-size: 1rem; margin-top: 10px; }
        .btn-submit:hover { transform: translateY(-3px); box-shadow: 0 10px 20px rgba(255,0,0,0.3); }
    </style>
</head>
<body>
    <div class="form-container">
        <h1>Join the Roster.</h1>
        <p>The streets have a voice. Show us yours.</p>
        <form id="artistForm">
            <div class="input-group">
                <label>Stage Name</label>
                <input type="text" placeholder="e.g. Young Vibe" required>
            </div>
            <div class="input-group">
                <label>Neighborhood / City</label>
                <input type="text" placeholder="e.g. Alagbaka, Akure" required>
            </div>
            <div class="input-group">
                <label>WhatsApp Number</label>
                <input type="tel" placeholder="080..." required>
            </div>
            <div class="input-group">
                <label>Link to your Best Work (Audiomack/SoundCloud)</label>
                <input type="url" placeholder="https://..." required>
            </div>
            <div class="input-group">
                <label>Tell us your Story</label>
                <textarea rows="4" placeholder="Why are you the next big thing?"></textarea>
            </div>
            <button type="submit" class="btn-submit">Submit Demo</button>
        </form>
    </div>
</body>
</html>
<%- include('partials/Header') %>

    <!-- Hero section background images are handled in CSS animation -->
    <section id="home" class="hero-slider">
		<!-- The Background Layers (Each image gets its own div) -->
		  <div class="slide" style="background-image: url('img/kilogram.png');"><span class="artist-name">Kilogram</span></div>
		  <div class="slide" style="background-image: url('img/jenny.png');"><span class="artist-name">Jenny</span></div>
		  <div class="slide" style="background-image: url('img/Polar.png');"><span class="artist-name">Polar</span></div>
		  <div class="slide" style="background-image: url('img/Bella.png');"><span class="artist-name">Bella</span></div>

        <div class="hero-content">
					<p class="tagline"> Record Label Reimagined.. </p>
            <h1>CCREATE. DISTRIBUTE. <br/>DOMINATE.</h1>
				<p> We scout the streets of Akure and beyond for the next sound of Africa. <br/>From the studio booth to the Chopvibe Fest stage—we turn raw energy into a global legacy.</p>
            <div class="button-container">
					<form method="post" action="/artist"><input type="submit" class="btn" value="Join Roster"></form>
					<form action="/service"><input type="submit" class="btn-s" value="Our Services"></form>
			</div>
        </div>
    </section>
	
	
